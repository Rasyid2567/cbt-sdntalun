<IfModule mod_rewrite.c>
    RewriteEngine On
    DirectoryIndex index.php

    # 1. Redirect akses GET langsung ke /index.php atau /index menuju /login
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{THE_REQUEST} ^GET\s+/(index\.php|index)(\?[^\s]*)?\s [NC]
    RewriteRule ^ /login [R=301,L]

    # 2. Alias URL /login ke index.php
    RewriteRule ^login/?$ index.php [L,QSA]

    # 3. Layani langsung file dan folder fisik yang ada (CSS, JS, Gambar, Uploads)
    RewriteCond %{REQUEST_FILENAME} -d [OR]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 4. Rewrite URL tanpa ekstensi .php ke file .php yang sesuai
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>
