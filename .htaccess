# Konfigurasi PHP untuk mendukung paket soal asesmen dengan banyak butir
<IfModule mod_php.c>
    php_value max_multipart_body_parts 10000
    php_value max_input_vars 10000
    php_value upload_max_filesize 64M
    php_value post_max_size 64M
    php_value output_buffering 4096
</IfModule>
<IfModule mod_php8.c>
    php_value max_multipart_body_parts 10000
    php_value max_input_vars 10000
    php_value upload_max_filesize 64M
    php_value post_max_size 64M
    php_value output_buffering 4096
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    DirectoryIndex index.php

    # 1. Pastikan routing modul (operator, guru, siswa) langsung dilayani oleh index.php
    # tanpa memicu 301 redirect DirectorySlash dari mod_dir yang dapat merusak method POST.
    RewriteRule ^(operator|guru|siswa)$ $1/index.php [L,QSA]
    RewriteRule ^(operator|guru|siswa)/$ $1/index.php [L,QSA]

    # 2. Redirect akses GET /index.php atau /index langsung ke /login
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{THE_REQUEST} ^GET\s+/(index\.php|index)(\?[^\s]*)?\s [NC]
    RewriteRule ^ /login [R=301,L]

    # 2. Redirect akses GET yang masih mengetik .php ke URL bersih tanpa .php (kecualikan folder api)
    RewriteCond %{REQUEST_URI} !^/api/ [NC]
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{THE_REQUEST} ^GET\s+([^\s?]+)\.php(\?[^\s]*)?\s [NC]
    RewriteRule ^ %1 [R=301,L]

    # 3. Alias URL /login ke index.php
    RewriteRule ^login/?$ index.php [L,QSA]

    # 4. Layani langsung file dan folder fisik yang ada (CSS, JS, Gambar, Uploads)
    RewriteCond %{REQUEST_FILENAME} -d [OR]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 5. Rewrite URL tanpa ekstensi .php ke file .php yang sesuai
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>


# Cache-Control & Browser Caching untuk Aset Statis (Gambar, WebP, SVG, CSS, JS)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(ico|jpg|jpeg|png|gif|webp|svg|css|js)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
</IfModule>
